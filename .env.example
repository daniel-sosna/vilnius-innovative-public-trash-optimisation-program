POSTGRES_DB=viptop
POSTGRES_USER=viptop
POSTGRES_PASSWORD=viptop
DATABASE_URL=postgresql+psycopg://viptop:viptop@db:5432/viptop
VASA_TILE_URL_TEMPLATE=https://atliekuaiksteles.vasa.lt/api/cluster/{z}/{x}/{y}
VASA_BIN_URL_TEMPLATE=https://atliekuaiksteles.vasa.lt/vasa-api/api/v1/dumpsters/{external_id}
VASA_HISTORY_URL_TEMPLATE=https://atliekuaiksteles.vasa.lt/vasa-api/api/v1/dumpsters-service-history/{external_id}
VASA_SCHEDULE_URL_TEMPLATE=https://atliekuaiksteles.vasa.lt/vasa-api/api/v1/dumpsters-schedule/{external_id}
BIN_SYNC_HTTP_TIMEOUT_SECONDS=30
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Running several worktrees at once (optional; see README "Running several worktrees"):
# Publish every service on a free host port chosen by Docker (use ";" on Windows):
# COMPOSE_FILE=docker-compose.yml:docker-compose.worktree.yml
# Fixed host ports; unset keeps 5173, 8000 and 5432 (or a Docker-chosen port in worktree mode):
# FRONTEND_PORT=5173
# BACKEND_PORT=8000
# DB_PORT=5432
# Host folder mounted as the backend's data directory (CSV exports, density file); relative
# to the repository root. Unset keeps backend/data. Lets worktrees share one folder:
# VIPTOP_DATA_DIR=../data
